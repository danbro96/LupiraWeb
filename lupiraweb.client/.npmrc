# Supply-chain hardening: never install a package version published less than
# 3 days ago. Gives malicious/compromised releases time to be detected and
# yanked before they can land in our tree. Requires npm >= 11.10.0.
# Unit is days. See https://socket.dev/blog/npm-introduces-minimumreleaseage-and-bulk-oidc-configuration
min-release-age=2
ignore-scripts=true
