# TrueNAS App "lupira-web" — populate these in the App's env section.
# Backend is a stateless BFF: it reads career data from lupira-career-api over HTTP
# (CAREERAPI_* below) and holds no database of its own.

# Image tag to run. `latest` tracks main. For rollback, pin to sha-<short>.
IMAGE_TAG=latest

# Host ports published on the TrueNAS box (your reverse proxy targets these).
FRONTEND_PORT=40080
BACKEND_PORT=40081

# CareerApi — career data from CareerApi's public read surface (/public/{handle}/…) over HTTP.
# Internal service-name reach over medelynas_data; use https://career-api.lupira.com if not co-located.
CAREERAPI_BASE_URL=http://lupira-career-api:8080
# Which published portfolio to read (CareerApi Profile.PublicHandle).
CAREERAPI_PUBLIC_HANDLE=danbro
# Machine token minted from Authentik (client_credentials); the backend caches + refreshes it.
# sub = lupira-web-svc service account, aud = lupira-career via the lupira-career-aud scope.
CAREERAPI_TOKEN_ENDPOINT=https://auth.lupira.com/application/o/token/
CAREERAPI_CLIENT_ID=lupira-web
CAREERAPI_CLIENT_SECRET=
CAREERAPI_SVC_USERNAME=lupira-web-svc
CAREERAPI_SVC_TOKEN=
CAREERAPI_SCOPE=openid lupira-career-aud

# OpenTelemetry — exports traces, metrics, logs to the platform OpenObserve collector.
# Leave OTEL_EXPORTER_OTLP_ENDPOINT blank to silence telemetry locally.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:5080/api/default
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Metric export cadence in ms. 300000 = 5 min — reduces ingest cost vs OTel default 60s.
OTEL_METRIC_EXPORT_INTERVAL=300000
# OpenObserve OSS requires authenticated ingestion. Generate the value via:
#   echo -n "<openobserve-admin-email>:<openobserve-admin-password>" | base64
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64>
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=prod,host.name=medelynas
